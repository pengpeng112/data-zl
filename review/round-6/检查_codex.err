237:def load_context_snapshot(db, context_id: str) -> dict[str, Any] | None:
238:    from sqlalchemy import select
240:    from ..models.ai_collab import AiContextSnapshot
242:    row = db.scalar(
243:        select(AiContextSnapshot).where(AiContextSnapshot.context_id == context_id)
244:    )
245:    if row is None:
246:        return None
247:    doc = dict(row.snapshot_json or {})
248:    doc["context_id"] = row.context_id
249:    doc["expired"] = bool(row.expires_at and row.expires_at < datetime.now(timezone.utc))
250:    return doc

