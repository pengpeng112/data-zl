462:@router.post("/tool-call", summary="记录工具调用（供审计）")
463:def log_tool_call(req: ToolCallLogRequest, db: Session = Depends(get_db)) -> ApiResponse[dict]:
464:    existing = db.scalar(select(AiSession).where(AiSession.session_key == req.session_key).limit(1))
465:    if not existing:
466:        db.add(AiSession(session_key=req.session_key, purpose="auto-created"))
