820:)
821:def system_context(
822:    system_code: str = Query(..., description="系统编码"),
823:    max_tables: int = Query(30, ge=1, le=100),
824:    db: Session = Depends(get_db),
825:) -> ApiResponse[dict]:
826:    from ...models.asset_system import AssetSystem
827:    from ...services.value_domain_service import confirmed_domains_for_injection
828:    sys = db.scalar(select(AssetSystem).where(AssetSystem.system_code == system_code))
829:    tables = db.scalars(
830:        select(AssetTable).where(AssetTable.system_code == system_code).limit(max_tables)
831:    ).all()
832:    total_tables = db.scalar(
833:        select(func.count()).select_from(AssetTable).where(AssetTable.system_code == system_code)
834:    ) or 0
836:    table_names = [f"{t.namespace_name or t.schema_name}.{t.table_name}" for t in tables]
837:    relations: list[dict] = []
838:    if table_names:
839:        rels = db.scalars(
840:            select(AssetRelation).where(
