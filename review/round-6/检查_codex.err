842:            )
843:        ).all()
844:        relations = [
845:            {"from": r.from_table, "to": r.to_table, "join_condition": r.join_condition,
846:             "confidence": r.confidence, "validation_status": r.validation_status}
847:            for r in rels
848:        ]
850:    total_columns = db.scalar(
851:        select(func.count()).select_from(AssetColumn).where(AssetColumn.system_code == system_code)
852:    )
853:    if total_columns is None:
854:        # fallback when column.system_code sparse: sum column_count on tables
855:        total_columns = sum(int(t.column_count or 0) for t in tables)
856:    total_relations = db.scalar(select(func.count()).select_from(AssetRelation)) or 0
857:    if table_names:
858:        total_relations = len(relations)
860:    # 149 P1c 主注入路径：该系统全部 confirmed 值域+陷阱（全量，不依赖列级解析；
861:    # 未裁决冲突与 pending/deprecated 已在服务层过滤），逐条回带 version_no 供留痕。
862:    value_domains = confirmed_domains_for_injection(db, system_code=system_code)
864:    return ApiResponse(data={
865:        "system_code": system_code,
866:        "system_name_cn": sys.system_name_cn if sys else system_code,
867:        "total_tables": total_tables,
868:        "total_columns": int(total_columns or 0),
869:        "total_relations": int(total_relations or 0),
870:        "exported_tables": len(tables),
871:        "tables": [
872:            {
873:                "name": f"{t.namespace_name or t.schema_name}.{t.table_name}",
874:                "table_name_cn": t.table_name_cn,
875:                "domain": t.domain,
876:                "column_count": t.column_count,
877:                "pk": t.pk,
878:            }
879:            for t in tables
880:        ],
881:        "relations": relations,
882:        "value_domains": value_domains,
883:        "value_domain_count": len(value_domains),
884:        "safety": "只读元数据，不含患者数据",
885:    })
888:class ToolExecuteRequest(BaseModel):
889:    tool_name: str
890:    system_code: str | None = None
891:    params: dict | None = None
894:class SqlScanRequest(BaseModel):
895:    sql_text: str
898:# Tools that can be safely dispatched inline (metadata-only, no source DB write)
899:_INLINE_TOOL_DISPATCH = {
900:    "sql_risk_scan",
901:    "list_tools",
902:}
905:@router.post(
906:    "/tool-execute",
907:    summary="AI 工具执行代理（只读，真实分发或明确不支持）",
908:    # 161 P2-3（round-2 P8 裁决）：当前 AVAILABLE_TOOLS 全部为只读组包工具（无真实
909:    # 执行类工具），整端点挂只读码 ai.context.read，不再让执行码套读接口；未来新增
910:    # 真实执行类工具时，改挂 ai.sql.execute 并在函数体内按工具名分流。
911:    dependencies=[Depends(require_permission("ai.context.read"))],
912:)
913:def tool_execute(req: ToolExecuteRequest, db: Session = Depends(get_db)) -> ApiResponse[dict]:
914:    """Never return fake executed=True. Dispatch known read-only helpers or mark unsupported."""
915:    tool_names = [t["name"] for t in AVAILABLE_TOOLS]
916:    if req.tool_name not in tool_names:
917:        raise HTTPException(status_code=400, detail=f"未注册的工具: {req.tool_name}，可用: {tool_names}")
919:    params = req.params or {}
920:    result: dict
921:    executed = False
922:    status = "unsupported"
924:    if req.tool_name == "sql_risk_scan":
925:        sql_text = str(params.get("sql_text") or "")
926:        flags = _scan_sql_risk(sql_text)
927:        result = {
928:            "sql_length": len(sql_text),
929:            "risk_flags": flags,
930:            "safe_for_review": not flags.get("blocked", False),
931:        }
932:        executed = True
933:        status = "success"
934:    elif req.tool_name == "get_system_context" and req.system_code:
935:        # Reuse system_context logic via internal call pattern
936:        ctx = system_context(system_code=req.system_code, max_tables=int(params.get("max_tables") or 30), db=db)
937:        result = ctx.data if hasattr(ctx, "data") else ctx
938:        executed = True
939:        status = "success"
940:    elif req.tool_name in _INLINE_TOOL_DISPATCH:
941:        result = {"note": f"tool {req.tool_name} registered; use dedicated endpoint"}
942:        executed = False
943:        status = "unsupported"
944:    else:
945:        # Explicit unsupported — client must call the dedicated path from AVAILABLE_TOOLS
946:        tool_meta = next((t for t in AVAILABLE_TOOLS if t["name"] == req.tool_name), {})
947:        result = {
948:            "note": "tool-execute does not proxy arbitrary HTTP; call the dedicated path",
949:            "method": tool_meta.get("method"),
950:            "path": tool_meta.get("path"),
951:            "auth_required": tool_meta.get("auth_required", True),
952:        }
953:        executed = False
954:        status = "unsupported"
956:    db.add(GovernAuditLog(
957:        module="ai",
958:        entity_type="tool_execute",
959:        entity_ref=req.tool_name,
960:        action="execute" if executed else "unsupported",
961:        after_data={"params": params, "status": status, "executed": executed},
962:        operator=req.system_code,
963:    ))
964:    db.commit()
965:    return ApiResponse(data={
966:        "tool_name": req.tool_name,
967:        "executed": executed,
968:        "status": status,
969:        "result": result,
970:    })
973:@router.post("/sql-risk-scan", summary="SQL 风险扫描（P10 增强，独立接口）")
974:def sql_risk_scan(req: SqlScanRequest) -> ApiResponse[dict]:
975:    flags = _scan_sql_risk(req.sql_text)
976:    return ApiResponse(data={
977:        "sql_length": len(req.sql_text),
978:        "risk_flags": flags,
979:        "safe_for_review": not flags.get("blocked", False),
980:    })
