740:def export_context(req: ExportRequest, db: Session = Depends(get_db)) -> ApiResponse[dict]:
741:    if not req.tables:
742:        raise HTTPException(status_code=400, detail="请至少选择 1 张表")
743:    if len(req.tables) > MAX_EXPORT_TABLES:
744:        raise HTTPException(status_code=400, detail=f"单次最多导出 {MAX_EXPORT_TABLES} 张表")
745:    stmt = select(AssetTable).where(
746:        (AssetTable.schema_name + "." + AssetTable.table_name).in_(req.tables)
747:    )
748:    tables = db.scalars(stmt).all()
749:    names = [f"{t.schema_name}.{t.table_name}" for t in tables]
751:    columns: list[dict] = []
752:    if req.include_columns and names:
753:        conds = [
754:            (AssetColumn.schema_name == t.schema_name)
755:            & (AssetColumn.table_name == t.table_name)
756:            for t in tables
757:        ]
758:        cols_q = select(AssetColumn).where(or_(*conds)) if conds else select(AssetColumn)
759:        for c in db.scalars(
760:            cols_q.order_by(AssetColumn.schema_name, AssetColumn.table_name, AssetColumn.column_id)
761:        ):
762:            columns.append(
763:                {
764:                    "table": f"{c.schema_name}.{c.table_name}",
765:                    "column": c.column_name,
766:                    "data_type": c.data_type,
767:                    "length": c.length,
768:                    "nullable": c.nullable,
769:                    "comment": c.comment,
770:                }
771:            )
773:    relations: list[dict] = []
774:    if req.include_relations and names:
775:        rels_q = select(AssetRelation).where(
776:            AssetRelation.from_table.in_(names) | AssetRelation.to_table.in_(names)
777:        )
778:        for r in db.scalars(rels_q):
779:            relations.append(
780:                {
781:                    "rel_id": r.rel_id,
782:                    "from": r.from_table,
783:                    "to": r.to_table,
784:                    "from_columns": r.from_columns,
785:                    "to_columns": r.to_columns,
786:                    "join_condition": r.join_condition,
787:                    "cardinality": r.cardinality,
788:                    "confidence": r.confidence,
789:                    "validation_status": r.validation_status,
790:                }
791:            )
793:    data = {
794:        "safety": "脱敏元数据：仅含表名/字段/类型/注释/已确认关系，不含患者数据与真实样本值",
795:        "tables": [
796:            {
797:                "name": f"{t.schema_name}.{t.table_name}",
798:                "comment": t.comment,
799:                "column_count": t.column_count,
800:                "domain": t.domain,
801:                "row_count_stats": t.row_count_stats,
802:                "pk": t.pk,
803:            }
804:            for t in tables
805:        ],
806:        "columns": columns,
807:        "relations": relations,
808:    }
809:    return ApiResponse(data=data)
