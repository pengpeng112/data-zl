44:def _finding_payload(db: Session, ids: list[int]) -> dict:
45:    if len(ids) != len(set(ids)):
46:        raise HTTPException(422, "duplicate finding_id")
47:    rows = list(db.scalars(select(QualityFinding).where(QualityFinding.id.in_(ids))).all())
48:    if len(rows) != len(ids):
49:        raise HTTPException(404, "finding not found")
50:    rows.sort(key=lambda row: row.id)
51:    rule_codes = {row.rule_code for row in rows if row.rule_code}
52:    rules = {
53:        row.rule_code: row
54:        for row in db.scalars(select(QualityRule).where(QualityRule.rule_code.in_(rule_codes))).all()
55:    } if rule_codes else {}
56:    # Platform catalog fields only. detail/sample_data never leave this function.
57:    findings = []
58:    for r in rows:
59:        rule = rules.get(r.rule_code)
60:        loc = resolve_finding_location(r, rule)
61:        rel_id = parse_relation_id(r.target_ref)
62:        item = {
63:            "finding_id": r.id,
64:            "run_id": r.run_id,
65:            "rule_code": r.rule_code,
66:            "rule_name": getattr(rule, "rule_name", None),
67:            "rule_type": getattr(rule, "rule_type", None),
68:            "rule_category": getattr(rule, "rule_category", None),
69:            "rule_description": getattr(rule, "description", None),
70:            "problem": finding_problem(r, rule),
71:            "target_display": finding_target_display(r),
72:            "target_type": r.target_type,
73:            "target_ref": r.target_ref,
74:            "system_code": r.system_code,
75:            "source_code": r.source_code,
76:            "schema_name": loc.schema_name or r.schema_name,
77:            "table_name": loc.table_name or r.table_name,
78:            "column_name": loc.column_name or r.column_name,
79:            "related_table": loc.related_table,
80:            "related_field": loc.related_column,
81:            "rel_id": rel_id,
82:            "severity": r.severity,
83:            "status": r.status,
84:            "metric_value": r.metric_value,
85:            "total_cnt": r.total_cnt,
86:            "error_cnt": r.error_cnt,
87:            "error_rate": r.error_rate,
88:        }
89:        hint = mixed_relation_hint(rel_id)
90:        if hint:
91:            item.update(hint)
92:        findings.append(item)
93:    return {"findings": attach_platform_examples(db, findings)}
96:def _build_source_payload(req, db: Session) -> dict:
97:    if req.task_type == "finding":
98:        if len(req.finding_ids) != 1 or req.run_id is not None:
99:            raise HTTPException(422, "finding requires exactly one finding_id")
100:        return _finding_payload(db, req.finding_ids)
101:    if req.task_type == "finding_batch":
102:        if not 2 <= len(req.finding_ids) <= settings.dify_max_findings_per_job or req.run_id is not None:
103:            raise HTTPException(422, "finding_batch requires 2-50 finding_ids")
104:        data = _finding_payload(db, req.finding_ids)["findings"]
105:        # Dify keeps the original same-scope contract. Hospital LLM can analyze
106:        # mixed tables so the workbench stays usable for real review.
107:        if not _hospital_ready():
108:            keys = {(x.get("system_code"), x.get("source_code"), x.get("namespace_name") or "",
109:                     x.get("schema_name") or "", x.get("table_name"), x.get("rule_code")) for x in data}
110:            if len(keys) != 1 or any(not k[0] or not k[1] or not k[3] or not k[4] or not k[5] for k in keys):
111:                raise HTTPException(422, "finding_batch must share system/source/schema/table/rule")
112:        return {"findings": data}
113:    if req.finding_ids or req.run_id is None:
114:        raise HTTPException(422, "run_summary requires run_id and no finding_ids")
115:    run = db.get(QualityCheckRun, req.run_id)
116:    if not run:
117:        raise HTTPException(404, "quality run not found")
118:    severity_rows = db.execute(
119:        select(QualityFinding.severity, func.count(QualityFinding.id))
120:        .where(QualityFinding.run_id == run.id)
121:        .group_by(QualityFinding.severity)
122:    ).all()
123:    status_rows = db.execute(
124:        select(QualityFinding.status, func.count(QualityFinding.id))
125:        .where(QualityFinding.run_id == run.id)
126:        .group_by(QualityFinding.status)
127:    ).all()
128:    table_rows = db.execute(
129:        select(QualityFinding.table_name, func.count(QualityFinding.id))
130:        .where(QualityFinding.run_id == run.id, QualityFinding.table_name.isnot(None))
131:        .group_by(QualityFinding.table_name)
132:        .order_by(func.count(QualityFinding.id).desc(), QualityFinding.table_name)
133:        .limit(10)
134:    ).all()
135:    return {"run_id": run.id, "system_code": run.system_code, "source_code": run.source_code,
136:            "status": run.status, "total_rules": run.total_rules, "total_findings": run.total_findings,
137:            "total_records": run.total_records, "error_records": run.error_records, "pass_rate": run.pass_rate,
138:            "severity_counts": {str(key or "unknown"): value for key, value in severity_rows},
139:            "status_counts": {str(key or "unknown"): value for key, value in status_rows},
140:            "top_tables": [{"table_name": table, "count": count} for table, count in table_rows]}
143:def _make(req, db, request_id):
144:    source = _build_source_payload(req, db)
145:    return build_payload(schema_version=INPUT_SCHEMA, request_id=request_id, task_type=req.task_type,
146:        prompt_version=settings.dify_quality_prompt_version, payload=source,
147:        max_bytes=settings.dify_max_payload_bytes, max_items=settings.dify_max_findings_per_job)
150:def _preview_signature(nonce: str) -> str:
151:    return hmac.new(settings.jwt_secret.encode(), f"ai-quality-preview:{nonce}".encode(), hashlib.sha256).hexdigest()[:32]
154:def _new_request_id() -> str:
155:    nonce = secrets.token_hex(12)
156:    return f"AQJ-{nonce}-{_preview_signature(nonce)}"
159:def _hospital_ready() -> bool:
160:    return bool(settings.hospital_llm_enabled and HospitalLlmClient().configured())
163:def _require_preview_request_id(request_id: str) -> None:
164:    parts = request_id.split("-")
165:    if len(parts) != 3 or parts[0] != "AQJ" or not hmac.compare_digest(parts[2], _preview_signature(parts[1])):
166:        raise HTTPException(422, "request_id was not issued by preview")
169:def _status_payload(db: Session | None = None):
170:    hospital = HospitalLlmClient()
171:    hospital_configured = hospital.configured()
172:    dify_configured = False
173:    try:
174:        DifyQualityClient()._api_key()
175:        dify_configured = True
176:    except DifyClientError:
177:        pass
178:    last_success = db.scalar(
179:        select(AiQualityJob.finished_at)
180:        .where(AiQualityJob.status == "succeeded")
181:        .order_by(AiQualityJob.finished_at.desc())
182:        .limit(1)
183:    ) if db is not None else None
184:    enabled = bool(settings.hospital_llm_enabled or settings.dify_quality_enabled)
185:    configured = (settings.hospital_llm_enabled and hospital_configured) or (settings.dify_quality_enabled and dify_configured)
186:    provider = "hospital_llm" if settings.hospital_llm_enabled and hospital_configured else (
187:        "dify" if settings.dify_quality_enabled and dify_configured else "none"
188:    )
189:    message = None
190:    if provider == "hospital_llm":
191:        message = "已接通院内模型。选中问题后可直接分析，只出建议、不改库、不执行 SQL。"
192:    elif not enabled:
193:        message = "AI 分析未启用。"
194:    elif not configured:
195:        message = "AI 质控当前未配置或处于关闭态，可查看问题但不能提交分析。"
196:    return {
197:        "enabled": enabled,
198:        "configured": configured,
199:        "reachable": None,
200:        "provider": provider,
201:        "workflow_name": settings.hospital_llm_model if provider == "hospital_llm" else settings.dify_quality_workflow_name,
202:        "prompt_version": settings.dify_quality_prompt_version,
203:        "schema_version": INPUT_SCHEMA,
204:        "max_findings": settings.dify_max_findings_per_job,
205:        "max_payload_bytes": settings.dify_max_payload_bytes,
206:        "timeout_seconds": settings.hospital_llm_read_timeout_seconds if provider == "hospital_llm" else settings.dify_read_timeout_seconds,
207:        "quota_state": "unknown",
208:        "last_success_at": last_success,
209:        "message": message,
210:        "hospital_llm": {
211:            "enabled": settings.hospital_llm_enabled,
212:            "configured": hospital_configured,
213:            "model": settings.hospital_llm_model,
214:            "host": "10.255.255.10:9000",
215:        },
216:    }
