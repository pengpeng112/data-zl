172:<script setup lang="ts">
173:import { computed, onMounted, onUnmounted, ref } from "vue";
174:import { ElMessage } from "element-plus";
175:import RePageHeader from "@/components/RePageHeader/index.vue";
176:import {
177:  getQualityFindings, getAiQualityStatus, testAiQualityConnection,
178:  previewAiQuality, createAiQualityJob, createGovernanceReport, getAiQualityJobs, getAiQualityJob,
179:  reviewAiQualityResult,
180:  type AiQualityJob, type AiQualityStatus, type AiQualityResultItem, type QualityFindingItem
181:} from "@/api/asset";
182:import { aiQualityErrorLabel, aiQualityJobStatusLabel, aiQualityStatusLabel, canSubmitAiQuality, limitFindingIds, usesHospitalLlm } from "./contracts";
183:import { liveDisplayText, objectText, renderReportHtml, severityLabel } from "./reportMarkdown";
185:const aiStatus = ref<AiQualityStatus | null>(null);
186:const connectionTesting = ref(false);
187:const findings = ref<QualityFindingItem[]>([]);
188:const findingsLoading = ref(false);
189:// 146 E3（R5）：待分析问题服务端分页状态；勾选跨页保留（reserve-selection + row-key）。
190:const findingsPage = ref(1);
191:const findingsPageSize = 50;
192:const findingsTotal = ref(0);
193:const findingStatus = ref("open");
194:const findingSeverity = ref("");
195:const selectedFindingIds = ref<number[]>([]);
196:const previewLoading = ref(false);
197:const submitting = ref(false);
198:const reportLoading = ref(false);
199:const jobs = ref<AiQualityJob[]>([]);
200:const jobsLoading = ref(false);
201:const jobsPage = ref(1);
202:const jobsPageSize = 20;
203:const jobsTotal = ref(0);
204:const selectedResult = ref<AiQualityResultItem | null>(null);
205:const acceptedRecommendationIndexes = ref<number[]>([]);
206:const reviewNote = ref("");
207:const analyzing = ref(false);
208:const liveText = ref("");
209:const livePhase = ref("");
210:const interruptedText = ref("");
211:let pollTimer: number | undefined;
213:const statusText = computed(() => aiQualityStatusLabel(aiStatus.value));
214:const hospitalReady = computed(() => usesHospitalLlm(aiStatus.value) && Boolean(aiStatus.value?.configured));
215:const modelName = computed(() => aiStatus.value?.hospital_llm?.model || "未配置");
216:const selectedRows = computed(() => selectedFindingRows.value);
217:const noiseText = computed(() => {
218:  const flag = selectedResult.value?.structured_result?.false_positive;
219:  if (!flag) return "需人工判断";
220:  return flag.possible ? `更像噪音。${flag.reason || ""}` : `需要处理。${flag.reason || ""}`;
221:});
223:async function loadStatus() {
224:  try { aiStatus.value = (await getAiQualityStatus()).data; }
225:  catch { aiStatus.value = { enabled: false, configured: false, message: "状态接口不可用" }; }
226:}
227:async function loadFindings() {
228:  findingsLoading.value = true;
229:  try {
230:    const data = (await getQualityFindings({
231:      page: findingsPage.value,
232:      page_size: findingsPageSize,
233:      status: findingStatus.value || undefined,
234:      severity: findingSeverity.value || undefined
235:    })).data;
236:    findings.value = data.items || [];
237:    findingsTotal.value = data.total || 0;
238:  } finally { findingsLoading.value = false; }
239:}
240:async function loadJobs() {
241:  jobsLoading.value = true;
242:  try {
243:    const data = (await getAiQualityJobs({ page: jobsPage.value, page_size: jobsPageSize })).data;
244:    jobs.value = data.items || [];
245:    jobsTotal.value = data.total || 0;
246:  } finally { jobsLoading.value = false; }
247:}
248:function rowSelectable(row: QualityFindingItem) {
249:  return selectedFindingIds.value.length < 50 || selectedFindingIds.value.includes(row.id);
250:}
251:// 146 E3（R5）：selection-change 携带保留选择+当前页全量勾选行，跨页累计不丢行。
252:const selectedFindingRows = ref<QualityFindingItem[]>([]);
253:function onSelectionChange(rows: QualityFindingItem[]) {
254:  selectedFindingRows.value = rows;
255:  selectedFindingIds.value = limitFindingIds(rows.map(row => row.id));
256:}
257:async function testConnection() {
258:  connectionTesting.value = true;
259:  try {
260:    aiStatus.value = (await testAiQualityConnection()).data;
261:    ElMessage.success("院内模型已接通");
262:  } catch { ElMessage.error("连接失败"); }
263:  finally { connectionTesting.value = false; }
264:}
265:function stopWatch() {
266:  if (pollTimer) {
267:    window.clearTimeout(pollTimer);
268:    pollTimer = undefined;
269:  }
270:}
271:async function watchJob(jobId: number | string) {
272:  analyzing.value = true;
273:  selectedResult.value = null;
274:  liveText.value = "";
275:  livePhase.value = "thinking";
276:  interruptedText.value = "";
277:  stopWatch();
278:  // 146 E3：轮询 10 分钟上限，指数退避 0.8s→10s，卸载即停止
279:  const POLL_TIMEOUT_MS = 10 * 60 * 1000;
280:  const startedAt = Date.now();
281:  let interval = 800;
282:  const tick = async () => {
283:    if (Date.now() - startedAt > POLL_TIMEOUT_MS) {
284:      analyzing.value = false;
285:      interruptedText.value = liveText.value;
286:      ElMessage.error("分析超时（10 分钟），已停止轮询，可稍后刷新查看结果");
287:      return;
288:    }
289:    try {
290:      const detail = (await getAiQualityJob(jobId)).data;
291:      liveText.value = detail.partial_text || liveText.value;
292:      livePhase.value = detail.phase || livePhase.value;
293:      jobs.value = [detail, ...jobs.value.filter(item => item.id !== detail.id)];
294:      if (detail.status === "succeeded" && detail.result) {
295:        selectedResult.value = detail.result;
296:        analyzing.value = false;
297:        ElMessage.success("分析完成");
298:        return;
299:      }
300:      if (["failed", "blocked", "unknown"].includes(detail.status)) {
301:        interruptedText.value = detail.partial_text || liveText.value;
302:        analyzing.value = false;
303:        ElMessage.error(aiQualityErrorLabel(detail.error_class));
304:        return;
305:      }
306:      interval = 800; // 成功轮询后重置退避
307:    } catch {
308:      interval = Math.min(interval * 2, 10000); // 瞬时失败退避，最多 10s
309:    }
310:    pollTimer = window.setTimeout(tick, interval);
311:  };
312:  await tick();
313:}
314:async function copyReport() {
315:  const result = selectedResult.value as any;
316:  const text = result?.structured_result?.summary || result?.summary || liveText.value || "";
317:  if (!text) {
318:    ElMessage.warning("暂无可复制的报告内容");
319:    return;
320:  }
321:  try {
322:    await navigator.clipboard.writeText(text);
323:    ElMessage.success("报告已复制");
324:  } catch {
325:    ElMessage.warning("剪贴板不可用，请手动选择复制");
326:  }
327:}
329:async function makeGovernanceReport() {
330:  reportLoading.value = true;
331:  try {
332:    const result = (await createGovernanceReport()).data;
333:    jobs.value = [result, ...jobs.value.filter(item => item.id !== result.id)];
334:    if (result.status === "succeeded" && result.result) selectedResult.value = result.result;
335:    else await watchJob(result.id);
336:  } catch { ElMessage.error("生成报告失败"); }
337:  finally { reportLoading.value = false; }
338:}
339:async function analyzeSelected() {
340:  if (!selectedFindingIds.value.length) {
341:    ElMessage.warning("请先勾选问题");
342:    return;
343:  }
344:  submitting.value = true;
345:  previewLoading.value = true;
346:  analyzing.value = true;
347:  selectedResult.value = null;
348:  liveText.value = "正在提交所选问题…";
349:  try {
350:    const taskType = selectedFindingIds.value.length === 1 ? "finding" : "finding_batch";
351:    const preview = (await previewAiQuality({
352:      task_type: taskType,
353:      finding_ids: selectedFindingIds.value
354:    })).data;
355:    if (!canSubmitAiQuality(aiStatus.value, preview)) {
356:      ElMessage.error("当前不能提交分析");
357:      analyzing.value = false;
358:      return;
359:    }
360:    const result = (await createAiQualityJob({
361:      task_type: preview.task_type,
362:      finding_ids: preview.finding_ids,
363:      input_digest: preview.input_digest,
364:      request_id: preview.request_id
365:    })).data;
366:    jobs.value = [result, ...jobs.value.filter(item => item.id !== result.id)];
367:    if (result.status === "succeeded" && result.result) {
368:      selectedResult.value = result.result;
369:      analyzing.value = false;
370:      ElMessage.success("分析完成");
371:    } else {
372:      await watchJob(result.id);
373:    }
374:  } catch { ElMessage.error("提交失败"); analyzing.value = false; }
375:  finally {
376:    submitting.value = false;
377:    previewLoading.value = false;
378:  }
379:}
380:async function selectJob(job: AiQualityJob) {
381:  acceptedRecommendationIndexes.value = [];
382:  selectedResult.value = job.result || null;
383:  if (!selectedResult.value) {
384:    try { selectedResult.value = (await getAiQualityJob(job.id)).data.result || null; }
385:    catch { ElMessage.error("加载失败"); }
386:  }
387:}
388:async function reviewJob(status: "accepted" | "rejected" | "partial") {
389:  if (!selectedResult.value) return;
390:  try {
391:    selectedResult.value = (await reviewAiQualityResult(selectedResult.value.id, {
392:      status, note: reviewNote.value, accepted_recommendations: acceptedRecommendationIndexes.value
393:    })).data;
394:    ElMessage.success("复核已保存");
395:  } catch { ElMessage.error("复核失败"); }
396:}
397:function statusTone(status: string) { return status === "可用" ? "success" : status === "连接失败" ? "danger" : "warning"; }
398:function riskTone(level?: string) { return level === "critical" || level === "high" ? "danger" : level === "medium" ? "warning" : "success"; }
399:function riskLabel(level?: string) {
400:  return ({ critical: "严重", high: "偏高", medium: "中等", low: "较低", unknown: "待判断" } as Record<string, string>)[level || ""] || "待判断";
401:}
402:function reviewLabel(status?: string) {
403:  return ({ pending: "待复核", accepted: "已接受", rejected: "已拒绝", partial: "部分接受" } as Record<string, string>)[status || ""] || "待复核";
404:}
405:onMounted(async () => {
406:  await loadStatus();
407:  await Promise.all([loadFindings(), loadJobs()]);
408:});
409:onUnmounted(() => stopWatch());
410:</script>
