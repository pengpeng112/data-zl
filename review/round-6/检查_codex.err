472:@router.get("/tool-calls", summary="查询工具调用记录")
473:def list_tool_calls(
474:    session_key: str | None = Query(None),
475:    page: int = Query(1, ge=1),
476:    page_size: int = Query(30, ge=1, le=200),
477:    db: Session = Depends(get_db),
478:) -> ApiResponse[dict]:
479:    stmt = select(AiToolCall)
480:    if session_key:
481:        stmt = stmt.where(AiToolCall.session_key == session_key)
482:    total = db.scalar(select(func.count()).select_from(stmt.subquery())) or 0
483:    rows = db.scalars(
484:        stmt.order_by(AiToolCall.called_at.desc())
485:        .offset((page - 1) * page_size)
486:        .limit(page_size)
487:    ).all()
488:    items = [
489:        {
490:            "id": r.id,
491:            "session_key": r.session_key,
492:            "tool_name": r.tool_name,
493:            "request": r.request,
494:            "response_summary": r.response_summary,
495:            "called_at": r.called_at.isoformat() if r.called_at else None,
496:        }
497:        for r in rows
498:    ]
499:    return ApiResponse(data={"total": total, "page": page, "page_size": page_size, "items": items})
502:@router.post(
503:    "/propose-sql",
504:    summary="AI 提交 SQL/视图草稿（仅保存，不执行；149 附精确字段值域）",
505:    dependencies=[Depends(require_permission("ai.context.read"))],
506:)
507:def propose_sql(req: ProposeSqlRequest, db: Session = Depends(get_db)) -> ApiResponse[dict]:
508:    risk_flags = _scan_sql_risk(req.sql_text)
509:    # 149 P1c 补充注入：基于 144 sqlglot（app/services/sql_ast.py）提取字段附精确值域；
510:    # 解析失败显式返回 value_domains_not_injected_reason，禁止静默。
511:    from ...services.value_domain_service import value_domains_for_sql
513:    vd = value_domains_for_sql(db, req.sql_text, dialect="oracle")
514:    draft = ViewDraft(
515:        session_key=req.session_key,
516:        title=req.title or "未命名",
517:        sql_text=req.sql_text,
518:        purpose=req.purpose,
519:        risk_flags=risk_flags,
520:    )
521:    db.add(draft)
522:    db.commit()
523:    db.refresh(draft)
525:    if req.session_key:
526:        _audit_tool_call(req.session_key, "propose_sql", {"sql_len": len(req.sql_text)}, f"draft_id={draft.id}", db)
528:    return ApiResponse(
529:        data={
530:            "draft_id": draft.id,
531:            "title": draft.title,
532:            "risk_flags": risk_flags,
533:            "value_domains": vd["value_domains"],
534:            "value_domain_injection": {
535:                "injected": vd["injected"],
536:                "matched_count": len(vd["value_domains"]),
537:                "parser_version": vd["parser_version"],
538:                "value_domains_not_injected_reason": vd["not_injected_reason"],
539:            },
540:            "warning": "草稿已保存，需人工审核后执行",
541:        }
542:    )
545:def _scan_sql_risk(sql: str) -> dict:
546:    # B7：危险词判定用整词（词边界）匹配，复用 db_connectors 的公共实现，
547:    # 避免 UPDATED_AT/CREATED_BY 等列名被子串匹配误杀；启发式（LAB_RESULT/
548:    # 大表/无 WHERE）保持原口径不搬运连接器校验。
549:    dangerous = ["DROP", "DELETE", "UPDATE", "INSERT", "ALTER", "TRUNCATE", "CREATE", "GRANT", "REVOKE"]
550:    found = forbidden_keyword_hits(sql, keywords=dangerous)
551:    upper = sql.upper()
552:    flags: dict = {}
553:    if found:
554:        flags["dangerous_keywords"] = found
555:        flags["blocked"] = True
556:    if "LAB_RESULT" in upper and "TEST_NO" not in upper:
557:        flags["big_table_warning"] = "LAB_RESULT 约 1 亿行，建议加 TEST_NO 限定"
558:    if "INP_BILL_DETAIL" in upper:
559:        flags["big_table_warning"] = "INP_BILL_DETAIL 约 2.15 亿行，需严格限定患者/时间/住院号"
560:    if "ORDERS" in upper and "PATIENT_ID" not in upper and "VISIT_ID" not in upper:
561:        flags["big_table_warning"] = "ORDERS 约 4103 万行，建议加 PATIENT_ID+VISIT_ID 限定"
562:    if "FROM" in upper and "WHERE" not in upper:
563:        flags["no_filter_warning"] = "SQL 缺少 WHERE 条件，可能触发大表全扫"
564:    return flags
567:@router.get("/drafts", summary="查询草稿列表")
568:def list_drafts(
569:    session_key: str | None = Query(None),
570:    status: str | None = Query(None),
571:    page: int = Query(1, ge=1),
572:    page_size: int = Query(20, ge=1, le=200),
573:    db: Session = Depends(get_db),
574:) -> ApiResponse[dict]:
575:    stmt = select(ViewDraft)
576:    if session_key:
577:        stmt = stmt.where(ViewDraft.session_key == session_key)
578:    if status:
579:        stmt = stmt.where(ViewDraft.status == status)
580:    total = db.scalar(select(func.count()).select_from(stmt.subquery())) or 0
581:    rows = db.scalars(
582:        stmt.order_by(ViewDraft.created_at.desc())
583:        .offset((page - 1) * page_size)
584:        .limit(page_size)
585:    ).all()
586:    items = [
587:        {
588:            "id": r.id,
589:            "session_key": r.session_key,
590:            "title": r.title,
591:            "sql_text": r.sql_text,
592:            "purpose": r.purpose,
593:            "status": r.status,
594:            "risk_flags": r.risk_flags,
595:            "created_at": r.created_at.isoformat() if r.created_at else None,
596:            "reviewed_by": r.reviewed_by,
597:            "reviewed_at": r.reviewed_at.isoformat() if r.reviewed_at else None,
598:            "feedback": r.feedback,
599:        }
600:        for r in rows
601:    ]
602:    return ApiResponse(data={"total": total, "page": page, "page_size": page_size, "items": items})
605:@router.patch("/drafts/{draft_id}", summary="审核草稿（通过/拒绝）", dependencies=[Depends(require_permission("asset.ai_draft.review"))])
606:def review_draft(
607:    draft_id: int,
608:    req: DraftReviewRequest, request: Request,
609:    db: Session = Depends(get_db),
610:) -> ApiResponse[dict]:
611:    current_user = get_current_user(request)
612:    draft = db.get(ViewDraft, draft_id)
613:    if not draft:
614:        raise HTTPException(status_code=404, detail="草稿不存在")
615:    draft.status = req.status
616:    draft.reviewed_by = current_user
617:    draft.reviewed_at = datetime.now(timezone.utc)
618:    draft.feedback = req.feedback
619:    db.commit()
620:    return ApiResponse(data={"id": draft.id, "status": draft.status, "feedback": draft.feedback})
623:@router.post(
624:    "/drafts/{draft_id}/execute",
625:    summary="Execute approved SQL draft in read-only mode",
626:    dependencies=[Depends(require_permission("ai.sql.execute"))],
627:)
628:def execute_approved_draft(
629:    draft_id: int,
630:    req: DraftExecuteRequest, request: Request,
631:    db: Session = Depends(get_db),
632:) -> ApiResponse[dict]:
633:    current_user = get_current_user(request)
634:    from ...services import quality_sql_runner
635:    from ...services.quality_rule_engine import validate_sql_safety
637:    draft = db.get(ViewDraft, draft_id)
638:    if not draft:
639:        raise HTTPException(status_code=404, detail="SQL draft not found")
640:    if draft.status != "approved":
641:        raise HTTPException(status_code=400, detail="SQL draft must be approved before execution")
643:    risk_flags = _scan_sql_risk(draft.sql_text or "")
644:    if risk_flags.get("blocked"):
645:        raise HTTPException(
646:            status_code=400,
647:            detail={"message": "SQL risk scan blocked execution", "risk_flags": risk_flags},
648:        )
650:    validation = validate_sql_safety(draft.sql_text or "")
651:    if not validation.get("valid"):
652:        raise HTTPException(
653:            status_code=400,
654:            detail={"message": "SQL safety validation failed", "errors": validation.get("errors", [])},
655:        )
657:    result = quality_sql_runner.execute_quality_sql(
658:        rule_code=f"AI_DRAFT_{draft.id}",
659:        sql=draft.sql_text or "",
660:        source_code=req.source_code,
661:        max_rows=req.max_rows,
662:        sample_limit=req.sample_limit,
663:        db=db,
664:    )
665:    if result.get("status") != "success":
666:        # B3：失败回显统一走 sanitize_text，防止 note 携带连接串/路径外泄。
667:        sanitized = {**result, "note": sanitize_text(str(result.get("note") or ""), limit=500)}
668:        raise HTTPException(status_code=400, detail={"message": "SQL execution failed", "result": sanitized})
670:    draft.status = "executed"
671:    draft.feedback = (draft.feedback or "") + f"\nexecuted_by={current_user}; source_code={req.source_code}"
672:    db.add(GovernAuditLog(
673:        module="ai",
674:        entity_type="sql_draft",
675:        entity_ref=str(draft.id),
676:        action="execute_readonly_sql",
677:        before_data={"status": "approved", "source_code": req.source_code},
678:        after_data={
679:            "status": result.get("status"),
680:            "total_cnt": result.get("total_cnt"),
681:            "error_cnt": result.get("error_cnt"),
682:            "error_rate": result.get("error_rate"),
683:            "warnings": result.get("warnings", []),
684:        },
685:        operator=current_user,
686:        reason=draft.purpose,
687:    ))
688:    db.commit()
690:    if draft.session_key:
691:        _audit_tool_call(
692:            draft.session_key,
693:            "execute_approved_sql",
694:            {"draft_id": draft.id, "source_code": req.source_code, "max_rows": req.max_rows},
695:            f"status={result.get('status')}; total_cnt={result.get('total_cnt')}; error_cnt={result.get('error_cnt')}",
696:            db,
697:        )
699:    return ApiResponse(data={
700:        "draft_id": draft.id,
701:        "source_code": req.source_code,
702:        "status": "executed",
703:        "risk_flags": risk_flags,
704:        "warnings": result.get("warnings", []),
705:        "total_cnt": result.get("total_cnt", 0),
706:        "error_cnt": result.get("error_cnt", 0),
707:        "error_rate": result.get("error_rate", 0),
708:        "sample_data": result.get("sample_data", []),
709:    })
