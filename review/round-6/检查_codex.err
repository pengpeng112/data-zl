100:              draftStatusLabel(row.status)
101:            }}</el-tag>
102:          </template>
103:        </el-table-column>
104:        <el-table-column label="操作" width="160" fixed="right">
105:          <template #default="{ row }">
106:            <template v-if="row.status === 'draft'">
107:              <el-button v-perms="'asset.ai_draft.review'" type="success" size="small" @click="approveDraft(row)"
108:                >通过</el-button
109:              >
110:              <el-button v-perms="'asset.ai_draft.review'" type="danger" size="small" @click="rejectDraft(row)"
111:                >拒绝</el-button
112:              >
113:            </template>
114:            <el-tag v-else type="info" size="small">已审核</el-tag>
115:          </template>
116:        </el-table-column>
117:      </el-table>
118:    </el-card>
119:
120:    <el-card>
121:      <template #header>AI 调用审计</template>
122:      <el-table v-loading="auditLoading" :data="auditItems" stripe size="small">
123:        <el-table-column
124:          prop="session_key"
125:          label="会话"
126:          width="120"
127:          show-overflow-tooltip
128:        />
129:        <el-table-column prop="tool_name" label="工具" width="150" />
130:        <el-table-column label="请求" width="200" show-overflow-tooltip>
131:          <template #default="{ row }">
132:            <span class="mono">{{ JSON.stringify(row.request || {}) }}</span>
133:          </template>
134:        </el-table-column>
135:        <el-table-column
136:          prop="response_summary"
137:          label="响应摘要"
138:          min-width="150"
139:          show-overflow-tooltip
140:        />
141:        <el-table-column prop="called_at" label="时间" width="170" />
142:      </el-table>
143:    </el-card>
144:  </div>
145:</template>
146:
147:<script setup lang="ts">
148:import RePageHeader from "@/components/RePageHeader/index.vue";
149:import ReStatCard from "@/components/ReStatCard/index.vue";
150:import { ref, onMounted } from "vue";
151:import { getAiTools, getDrafts, getToolCalls, reviewDraft, listSystems, getAiSystemContext } from "@/api/asset";
152:import { extractErrorDetail } from "@/utils/errorMessage";
153:import type { AiToolDef, ViewDraftItem, AiToolCallItem } from "@/api/asset";
154:import { ElMessage } from "element-plus";
155:
156:interface SystemOption {
157:  system_code: string;
158:}
159:
160:interface SystemContext {
161:  total_tables: number;
162:  total_columns: number;
163:  total_relations: number;
164:}
165:
166:const systemCode = ref("");
167:const systemOptions = ref<SystemOption[]>([]);
168:const systemContext = ref<SystemContext | null>(null);
169:
170:const tools = ref<AiToolDef[]>([]);
171:const policy = ref("");
172:
173:const drafts = ref<ViewDraftItem[]>([]);
174:const draftsLoading = ref(false);
175:const draftStatusFilter = ref("draft");
176:
177:const auditItems = ref<AiToolCallItem[]>([]);
178:const auditLoading = ref(false);
179:
180:function draftStatusLabel(s: string | null) {
181:  const m: Record<string, string> = {
182:    draft: "草稿",
183:    approved: "已通过",
184:    rejected: "已拒绝"
185:  };
186:  return m[s ?? ""] || s || "";
187:}
188:
189:function draftStatusTag(s: string | null): any {
190:  const m: Record<string, string> = {
191:    draft: "warning",
192:    approved: "success",
193:    rejected: "danger"
194:  };
195:  return m[s ?? ""] || "";
196:}
197:
198:function loadSystems() {
199:  // F4：裸 http 收编到 listSystems。
200:  listSystems()
201:    .then(({ data }) => {
202:      systemOptions.value = data as any;
203:    })
204:    .catch(() => {
205:      // 下拉选项加载失败保持空列表（非关键路径）。
206:      systemOptions.value = [];
207:    });
208:}
209:
210:function loadSystemContext() {
211:  if (!systemCode.value) {
212:    systemContext.value = null;
213:    return;
214:  }
215:  // F4：裸 http 收编到 getAiSystemContext。
216:  getAiSystemContext(systemCode.value)
217:    .then(({ data }) => {
218:      systemContext.value = data as any;
219:    })
220:    .catch(error => {
221:      systemContext.value = null;
222:      ElMessage.error(extractErrorDetail(error, "系统上下文加载失败"));
223:    });
224:}
225:
226:function loadAll() {
227:  getAiTools().then(({ data }) => {
228:    tools.value = data.tools;
229:    policy.value = data.policy;
230:  });
231:  loadDrafts();
232:  loadAudit();
233:  loadSystems();
234:}
235:
236:function loadDrafts() {
237:  draftsLoading.value = true;
238:  getDrafts({ status: draftStatusFilter.value || undefined })
239:    .then(({ data }) => {
240:      drafts.value = data.items;
241:    })
242:    .finally(() => {
243:      draftsLoading.value = false;
244:    });
245:}
246:
247:function loadAudit() {
248:  auditLoading.value = true;
249:  getToolCalls({ page_size: 30 })
250:    .then(({ data }) => {
251:      auditItems.value = data.items;
252:    })
253:    .finally(() => {
254:      auditLoading.value = false;
255:    });
256:}
257:
258:function approveDraft(row: ViewDraftItem) {
259:  reviewDraft(row.id, { status: "approved", reviewed_by: "manual" })
260:    .then(() => {
261:      ElMessage.success("已通过");
262:      loadDrafts();
263:    })
264:    .catch(() => {});
265:}
266:
267:function rejectDraft(row: ViewDraftItem) {
268:  reviewDraft(row.id, { status: "rejected", reviewed_by: "manual" })
269:    .then(() => {
270:      ElMessage.success("已拒绝");
271:      loadDrafts();
272:    })
273:    .catch(() => {});
274:}
275:
276:onMounted(loadAll);
277:</script>
278:
279:<style scoped>
280:.mb20 {
281:  margin-bottom: 20px;
282:}
283:.mr5 {
284:  margin-right: 5px;
285:}
286:.mono {
287:  font-family: "Courier New", monospace;
288:  font-size: 12px;
289:}
290:.policy-note {
291:  color: var(--text-secondary);
292:  font-size: 13px;
293:  padding: 4px 0;
294:}
295:.ai-tools-page {
296:  padding: 4px;
297:}
298:.context-stat-grid {
299:  display: grid;
300:  grid-template-columns: repeat(3, minmax(0, 1fr));
301:  gap: 16px;
302:}
303:@media (max-width: 760px) {
304:  .context-stat-grid {
305:    grid-template-columns: 1fr;
306:  }
307:}
308:</style>

