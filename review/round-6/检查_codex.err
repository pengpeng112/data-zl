27:写清系统、库/Schema、表（中文名+英文名）、字段或关系两端。引用传入的对象，不要另编表名。
29:【明细举例】
30:用传入的“缺注释字段/关系键/指标”举 3 到 8 个具体例子，说明缺什么、对使用有什么影响。
31:没有例子就写“平台库未登记到字段明细”。
33:【要不要处理】
34:明确写：需要处理 / 可暂缓 / 更像噪音。给出理由。
36:【处理建议】
37:给 2 到 4 条可执行步骤，每条一行，用“1.”开头，说明谁去做、改平台目录还是等业务确认。
39:字段名 PATIENT_ID / VISIT_ID / EXAM_NO / TEST_NO 可以原样写，这是表字段名，不是患者隐私。
40:不要写真实姓名、身份证号、手机号。
41:如果材料里有 already_split_to 或 handling_hint，结论必须写明：混合关系已经拆开，去看拆后的正式关系，不要建议按混合关系改业务数据。
42:"""
45:def build_analysis_prompt(*, task_type: str, request_id: str, input_digest: str, payload_json: str) -> str:
46:    return "\n".join([
47:        ANALYSIS_PROMPT_HEADER,
48:        f"任务类型：{task_type}",
49:        f"request_id={request_id}",
50:        "平台库传入的问题和字段例子：",
51:        payload_json,
52:    ])
55:def extract_json_object(text: str) -> dict[str, Any] | None:
56:    cleaned = _JSON_FENCE.sub("", (text or "").strip())
57:    start = cleaned.find("{")
58:    end = cleaned.rfind("}")
59:    if start < 0 or end <= start:
60:        return None
61:    try:
62:        parsed = json.loads(cleaned[start:end + 1])
63:    except json.JSONDecodeError:
64:        return None
65:    return parsed if isinstance(parsed, dict) else None
68:def parse_cn_sections(text: str) -> dict[str, str]:
69:    raw = (text or "").strip()
70:    if not raw:
71:        return {}
72:    matches = list(_SECTION.finditer(raw))
73:    if not matches:
74:        return {"结论": raw}
75:    sections: dict[str, str] = {}
76:    for index, match in enumerate(matches):
77:        end = matches[index + 1].start() if index + 1 < len(matches) else len(raw)
78:        body = raw[match.end():end].strip()
79:        if body:
80:            sections[match.group(1).strip()] = body
81:    return sections
84:def _looks_like_noise(text: str) -> bool:
85:    return any(token in (text or "") for token in ("噪音", "可暂缓", "可忽略", "不必处理", "目录展示"))
88:def _lines(text: str) -> list[str]:
89:    rows = []
90:    for line in re.split(r"[\n；;]", text or ""):
91:        item = re.sub(r"^[\-\*\d\.、)\s]+", "", line).strip()
92:        if item:
93:            rows.append(item)
94:    return rows
97:def _as_output_dict(raw: dict[str, Any], *, request_id: str, input_digest: str, fallback_text: str) -> dict[str, Any]:
98:    sections = parse_cn_sections(fallback_text)
99:    summary = str(
100:        raw.get("summary")
101:        or sections.get("结论")
102:        or fallback_text
103:        or "院内模型已返回分析，请人工复核。"
104:    ).strip()[:4000]
105:    if summary.lstrip().startswith("{"):
106:        summary = sections.get("结论") or "院内模型已返回分析，请人工复核。"
107:    risk = str(raw.get("risk_level") or "medium").strip().lower()
108:    if "严重" in summary or "必须处理" in summary:
109:        risk = "high"
110:    if any(token in summary for token in ("可暂缓", "噪音", "一般")):
111:        risk = "low" if risk == "medium" else risk
112:    if risk not in {"critical", "high", "medium", "low", "unknown"}:
113:        risk = "medium"
114:    causes = raw.get("root_causes") if isinstance(raw.get("root_causes"), list) else []
115:    recs = raw.get("recommendations") if isinstance(raw.get("recommendations"), list) else []
116:    if not causes:
117:        for title, key in (("问题定位", "问题定位"), ("明细举例", "明细举例")):
118:            if sections.get(key):
119:                causes.append({"title": title, "reason": sections[key], "confidence": 0.75, "evidence_finding_ids": []})
120:    if not recs:
121:        recs = [
122:            {
123:                "title": line[:300],
124:                "action_type": "manual_review",
125:                "priority": "P2",
126:                "reason": line[:2000],
127:                "confidence": 0.7,
128:                "target_refs": [],
129:            }
130:            for line in _lines(sections.get("处理建议") or "")[:4]
131:        ]
132:    noise = sections.get("要不要处理") or ""
133:    false_positive = raw.get("false_positive") if isinstance(raw.get("false_positive"), dict) else {}
134:    return {
135:        "schema_version": "quality-analysis-output/v1",
136:        "request_id": request_id,
137:        "input_digest": input_digest,
138:        "summary": summary or "院内模型已返回分析，请人工复核。",
139:        "risk_level": risk,
140:        "root_causes": [
141:            {
142:                "title": str(item.get("title") or "可能原因")[:300],
143:                "reason": str(item.get("reason") or item.get("title") or "需人工复核")[:2000],
144:                "confidence": min(max(float(item.get("confidence") or 0.7), 0.0), 1.0),
145:                "evidence_finding_ids": [
146:                    int(fid) for fid in (item.get("evidence_finding_ids") or [])[:20] if str(fid).isdigit()
147:                ],
148:            }
149:            for item in causes[:8] if isinstance(item, dict) and (item.get("title") or item.get("reason"))
150:        ],
151:        "recommendations": [
152:            {
153:                "title": str(item.get("title") or "建议人工复核")[:300],
154:                "action_type": item.get("action_type") if item.get("action_type") in {
155:                    "rule_adjustment", "data_remediation", "metadata_fix", "manual_review", "monitor",
156:                } else "manual_review",
157:                "priority": item.get("priority") if str(item.get("priority") or "") in {"P0", "P1", "P2", "P3"} else "P2",
158:                "reason": str(item.get("reason") or "院内模型建议，需人工确认")[:2000],
159:                "confidence": min(max(float(item.get("confidence") or 0.7), 0.0), 1.0),
160:                "target_refs": [str(ref)[:500] for ref in (item.get("target_refs") or [])[:10]],
161:            }
162:            for item in recs[:8] if isinstance(item, dict) and item.get("title")
163:        ],
164:        "false_positive": {
165:            "possible": bool(false_positive.get("possible")) if false_positive else _looks_like_noise(noise or summary),
166:            "reason": str(false_positive.get("reason") or noise or "需人工判断是否误报")[:2000],
167:        },
168:        "follow_up_checks": [
169:            {"description": str(item.get("description") or "")[:2000], "sql_draft": None}
170:            for item in (raw.get("follow_up_checks") or [])[:8]
171:            if isinstance(item, dict) and item.get("description")
172:        ],
173:        "limitations": [
174:            "未直连 HIS/ODS/嘉和业务库",
175:            "举例来自数据资产平台库登记的字段/关系，不是业务库抽样",
176:            "结论需人工复核后才能改规则或关系",
177:        ],
178:    }
181:def analysis_from_llm_text(text: str, *, request_id: str, input_digest: str) -> QualityOutput:
182:    cleaned = redact_concrete_pii(text or "")
183:    parsed = extract_json_object(cleaned) if cleaned.lstrip().startswith("{") else None
184:    payload = _as_output_dict(parsed or {}, request_id=request_id, input_digest=input_digest, fallback_text=cleaned)
185:    if not payload["root_causes"]:
186:        payload["root_causes"] = [{
187:            "title": "问题说明",
188:            "reason": (cleaned or "模型未给出结构化说明")[:2000],
189:            "confidence": 0.55,
190:            "evidence_finding_ids": [],
191:        }]
192:    if not payload["recommendations"]:
193:        payload["recommendations"] = [{
194:            "title": "在平台目录补全中文名/注释后再复核是否还要处理",
195:            "action_type": "metadata_fix",
196:            "priority": "P2",
197:            "reason": "先把对象看清楚，再决定要不要动业务。",
198:            "confidence": 0.8,
199:            "target_refs": [],
200:        }]
201:    payload["summary"] = redact_concrete_pii(payload["summary"])
202:    for item in payload["root_causes"]:
203:        item["reason"] = redact_concrete_pii(item["reason"])
204:        item["title"] = redact_concrete_pii(item["title"])
205:    for item in payload["recommendations"]:
206:        item["title"] = redact_concrete_pii(item["title"])
207:        item["reason"] = redact_concrete_pii(item["reason"])
208:    payload["false_positive"]["reason"] = redact_concrete_pii(payload["false_positive"]["reason"])
209:    return validate_output(payload, request_id=request_id, input_digest=input_digest)
212:def attach_platform_examples(db: Session, findings: list[dict[str, Any]]) -> list[dict[str, Any]]:
213:    """Add catalog-only column/relation examples. Never touches business DBs."""
214:    from ..models.asset import AssetColumn, AssetRelation, AssetTable
216:    enriched = []
217:    for item in findings:
218:        schema = str(item.get("schema_name") or "")
219:        table = str(item.get("table_name") or "")
220:        extra = dict(item)
221:        if table:
222:            table_row = db.scalar(
223:                select(AssetTable).where(
224:                    func.upper(AssetTable.table_name) == table.upper(),
225:                    or_(func.upper(func.coalesce(AssetTable.schema_name, "")) == schema.upper(), schema == ""),
226:                ).limit(1)
227:            )
228:            if table_row:
229:                extra["table_name_cn"] = table_row.table_name_cn
230:                extra["system_name_cn"] = extra.get("system_name_cn")
231:            cols = list(db.scalars(
232:                select(AssetColumn).where(func.upper(AssetColumn.table_name) == table.upper())
233:                .order_by(AssetColumn.column_id.asc().nullslast())
234:                .limit(80)
235:            ).all())
236:            if schema:
237:                scoped = [col for col in cols if str(col.schema_name or "").upper() == schema.upper()]
238:                if scoped:
239:                    cols = scoped
240:            missing = []
241:            named = []
242:            for col in cols:
243:                label = str(col.column_name_cn or col.comment or "").strip()
244:                pack = {
245:                    "column_name": col.column_name,
246:                    "data_type": col.data_type,
247:                    "column_name_cn": label or None,
248:                }
249:                if label:
250:                    named.append(pack)
251:                else:
252:                    missing.append(pack)
253:            extra["column_count"] = len(cols)
254:            extra["missing_comment_count"] = len(missing)
255:            extra["missing_comment_columns"] = missing[:12]
256:            extra["example_named_columns"] = named[:5]
257:            rels = list(db.scalars(
258:                select(AssetRelation).where(
259:                    or_(
260:                        AssetRelation.from_table.ilike(f"%{table}"),
261:                        AssetRelation.to_table.ilike(f"%{table}"),
262:                    )
263:                ).limit(8)
264:            ).all())
265:            extra["related_relations"] = [
266:                {
267:                    "from_table": rel.from_table,
268:                    "to_table": rel.to_table,
269:                    "from_columns": rel.from_columns,
270:                    "to_columns": rel.to_columns,
271:                    "validation_status": rel.validation_status,
272:                    "validation_metrics": (rel.validation_metrics or "")[:180],
273:                }
274:                for rel in rels
275:            ]
276:        enriched.append(extra)
277:    return enriched

