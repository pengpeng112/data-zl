994:@router.post(
995:    "/context/resolve",
996:    summary="144 S6：按问题/系统/业务域构建统一上下文快照",
997:    dependencies=[Depends(require_permission("ai.context.read"))],
998:)
999:def resolve_context(
1000:    req: ContextResolveRequest, request: Request, db: Session = Depends(get_db)
1001:) -> ApiResponse[dict]:
1002:    from ...services.ai_context_builder import build_context_snapshot
1004:    try:
1005:        doc = build_context_snapshot(
1006:            db,
1007:            question_summary=req.question_summary,
1008:            system_code=req.system_code,
1009:            source_code=req.source_code,
1010:            business_domain=req.business_domain,
1011:            max_objects=req.max_objects,
1012:            include_sql=False,  # unified context never carries full SQL (144 §4.6)
1013:            created_by=getattr(request.state, "user_identifier", None),
1014:        )
1015:        db.commit()
1016:    except Exception as exc:  # sanitized error taxonomy only
1017:        db.rollback()
1018:        raise HTTPException(status_code=500, detail="上下文构建失败，请稍后重试") from exc
1019:    return ApiResponse(data=doc)
1022:@router.get(
1023:    "/context/{context_id}",
1024:    summary="144 S6：读取可复现上下文（含过期/截断状态）",
1025:    dependencies=[Depends(require_permission("ai.context.read"))],
1026:)
1027:def get_context(
1028:    context_id: str,
1029:    db: Session = Depends(get_db),
1030:) -> ApiResponse[dict]:
1031:    from ...services.ai_context_builder import load_context_snapshot
1033:    doc = load_context_snapshot(db, context_id)
1034:    if doc is None:
1035:        raise HTTPException(status_code=404, detail=f"context 不存在: {context_id}")
1036:    return ApiResponse(data=doc)

