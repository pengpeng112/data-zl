224:@router.post("/connection-test", dependencies=[Depends(require_permission("asset.quality.ai.connection_test"))])
225:def connection_test(request: Request, db: Session = Depends(get_db)) -> ApiResponse[dict]:
226:    operator = get_current_user(request)
227:    if settings.hospital_llm_enabled:
228:        try:
229:            result = HospitalLlmClient().connection_test()
230:            _audit(db, "connection_test", "hospital_llm", settings.hospital_llm_model,
231:                   operator, {"reachable": True, "model": result.get("model")})
232:            db.commit()
233:            payload = _status_payload(db)
234:            payload["reachable"] = True
235:            payload["sample"] = result.get("sample")
236:            return ApiResponse(data=payload)
237:        except HospitalLlmError as exc:
238:            _audit(db, "connection_test_failed", "hospital_llm", settings.hospital_llm_model,
239:                   operator, {"error_class": exc.error_class})
240:            db.commit()
241:            raise HTTPException(503, detail={"error_class": exc.error_class}) from exc
242:    if not settings.dify_quality_enabled:
243:        raise HTTPException(409, "AI analysis is disabled")
244:    try:
245:        result = DifyQualityClient().connection_test()
246:        _audit(db, "connection_test", "dify_workflow", settings.dify_quality_workflow_name,
247:               operator, {"reachable": True})
248:        db.commit()
249:        return ApiResponse(data={**_status_payload(db), **result})
250:    except DifyClientError as exc:
251:        _audit(db, "connection_test_failed", "dify_workflow", settings.dify_quality_workflow_name,
252:               operator, {"error_class": exc.error_class})
253:        db.commit()
254:        raise HTTPException(503, detail={"error_class": exc.error_class}) from exc
257:@router.post("/preview", dependencies=[Depends(require_permission("asset.quality.ai.analyze"))])
258:def preview(req: AiQualityPreviewRequest, db: Session = Depends(get_db)) -> ApiResponse[dict]:
259:    request_id = _new_request_id()
260:    try:
261:        built = _make(req, db, request_id)
262:        source = _build_source_payload(req, db)
263:        item_count = len(source.get("findings", [])) if "findings" in source else 1
264:        safe_fields = sorted({
265:            key
266:            for item in source.get("findings", [source])
267:            for key in item
268:        })
269:        return ApiResponse(data={
270:            **built,
271:            "finding_ids": sorted(req.finding_ids),
272:            "run_id": req.run_id,
273:            "item_count": item_count,
274:            "fields": safe_fields,
275:            "dropped_count": len(built["dropped_fields"]),
276:            "redacted_count": sum(1 for value in built["dropped_fields"] if value),
277:            "warnings": [],
278:        })
279:    except ValueError as exc:
280:        raise HTTPException(422, str(exc)) from exc
283:def _job_item(job):
284:    return AiQualityJobItem.model_validate(job).model_dump()
287:def _job_payload(db: Session, job: AiQualityJob) -> dict:
288:    result = db.scalar(select(AiQualityResult).where(AiQualityResult.job_id == job.id))
289:    finding_ids = list(db.scalars(
290:        select(AiQualityJobFinding.finding_id)
291:        .where(AiQualityJobFinding.job_id == job.id)
292:        .order_by(AiQualityJobFinding.finding_id)
293:    ).all())
294:    usage = job.token_usage if isinstance(job.token_usage, dict) else {}
295:    return {**_job_item(job), "finding_ids": finding_ids,
296:            "run_id": (job.input_summary or {}).get("run_id"),
297:            "partial_text": usage.get("partial_text") or "",
298:            "phase": usage.get("phase") or "",
299:            "result": AiQualityResultItem.model_validate(result).model_dump() if result else None}
302:def _recover_stale(db):
303:    # A process restart must never silently resubmit an ambiguous blocking call.
304:    cutoff = datetime.now(timezone.utc) - timedelta(seconds=settings.dify_stale_running_seconds)
305:    stale_jobs = list(db.scalars(select(AiQualityJob).where(
306:        AiQualityJob.status == "running", AiQualityJob.started_at < cutoff
307:    )).all())
308:    for job in stale_jobs:
309:        job.status = "unknown"
310:        job.error_class = "stale_running"
311:        job.error_summary = "Task was running when observation window expired"
312:        _audit(db, "stale_recovery", "ai_quality_job", job.id, "system",
313:               {"status": "unknown", "error_class": "stale_running"})
314:    if stale_jobs:
315:        db.commit()
318:@router.get("/jobs", dependencies=[Depends(require_permission("asset.quality.ai.view"))])
319:def jobs(page: int = Query(1, ge=1), page_size: int = Query(20, ge=1, le=100), db: Session = Depends(get_db)) -> ApiResponse[PageData[dict]]:
320:    _recover_stale(db)
321:    total = db.scalar(select(func.count()).select_from(AiQualityJob)) or 0
322:    rows = db.scalars(select(AiQualityJob).order_by(desc(AiQualityJob.created_at)).offset((page - 1) * page_size).limit(page_size)).all()
323:    return ApiResponse(data=PageData(total=total, page=page, page_size=page_size, items=[_job_payload(db, row) for row in rows]))
326:@router.get("/jobs/{job_id}", dependencies=[Depends(require_permission("asset.quality.ai.view"))])
327:def job_detail(job_id: int, db: Session = Depends(get_db)) -> ApiResponse[dict]:
328:    _recover_stale(db)
329:    job = db.get(AiQualityJob, job_id)
330:    if not job: raise HTTPException(404, "job not found")
331:    return ApiResponse(data=_job_payload(db, job))
334:def _new_job(req: AiQualityCreateRequest, db: Session, operator: str, payload: dict, *, retry_job=None, prompt_version: str):
335:    key_material = f"quality|{req.task_type}|{sorted(req.finding_ids)}|{req.run_id}|{payload['input_digest']}|{prompt_version}"
336:    job_key = hashlib.sha256(key_material.encode()).hexdigest()
337:    job = retry_job or db.scalar(select(AiQualityJob).where(AiQualityJob.job_key == job_key))
338:    if job and retry_job is None:
339:        _audit(db, "reuse", "ai_quality_job", job.id, operator, {"status": job.status})
340:        db.commit()
341:        return job, None
342:    job = job or AiQualityJob(
343:        job_key=job_key, task_type=req.task_type, prompt_version=prompt_version,
344:        schema_version=INPUT_SCHEMA, input_digest=payload["input_digest"], request_id=req.request_id,
345:        input_summary={"finding_count": len(req.finding_ids), "finding_ids": sorted(req.finding_ids),
346:                       "run_id": req.run_id, "payload_bytes": payload["payload_bytes"],
347:                       "dropped_count": len(payload["dropped_fields"]), "provider": "hospital_llm" if _hospital_ready() else "dify"},
348:        requested_by=operator)
349:    job.status, job.attempt, job.started_at = "running", (job.attempt or 0) + 1, datetime.now(timezone.utc)
350:    db.add(job)
351:    db.flush()
352:    for fid in sorted(set(req.finding_ids)):
353:        if not db.scalar(select(AiQualityJobFinding).where(AiQualityJobFinding.job_id == job.id, AiQualityJobFinding.finding_id == fid)):
354:            db.add(AiQualityJobFinding(job_id=job.id, finding_id=fid))
355:    _audit(db, "submit", "ai_quality_job", job.id, operator, {"input_digest": job.input_digest})
356:    db.commit()
357:    return job, payload
360:def _save_partial(db: Session, job_id: int, text: str, phase: str) -> None:
361:    job = db.get(AiQualityJob, job_id)
362:    if not job:
363:        return
364:    usage = dict(job.token_usage or {})
365:    usage["partial_text"] = text[-4000:]
366:    usage["phase"] = phase
367:    job.token_usage = usage
368:    db.add(job)
369:    db.commit()
372:def _finish_hospital_job(job_id: int, payload: dict, operator: str, request_id: str) -> None:
373:    db = SessionLocal()
374:    started = time.monotonic()
375:    try:
376:        job = db.get(AiQualityJob, job_id)
377:        if not job:
378:            return
379:        prompt = build_analysis_prompt(
380:            task_type=job.task_type,
381:            request_id=request_id,
382:            input_digest=payload["input_digest"],
383:            payload_json=payload["payload_json"],
384:        )
385:        pieces: list[str] = []
386:        last_flush = time.monotonic()
387:        _save_partial(db, job_id, "院内模型思考中…", "thinking")
388:        for chunk in HospitalLlmClient().complete_stream(prompt, max_tokens=1800):
389:            pieces.append(chunk)
390:            if time.monotonic() - last_flush >= 0.4:
391:                _save_partial(db, job_id, "".join(pieces), "writing")
392:                last_flush = time.monotonic()
393:        text = "".join(pieces)
394:        _save_partial(db, job_id, text, "writing")
395:        result = analysis_from_llm_text(text, request_id=request_id, input_digest=payload["input_digest"])
396:        job = db.get(AiQualityJob, job_id)
397:        if db.scalar(select(AiQualityResult).where(AiQualityResult.job_id == job_id)) is None:
398:            db.add(AiQualityResult(
399:                job_id=job_id, risk_level=result.risk_level, summary=result.summary,
400:                structured_result=result.model_dump(), output_digest=output_digest(result),
401:            ))
402:        job.status = "succeeded"
403:        job.dify_run_id = settings.hospital_llm_model[:64]
404:        job.duration_ms = int((time.monotonic() - started) * 1000)
405:        job.finished_at = datetime.now(timezone.utc)
406:        _audit(db, "succeeded", "ai_quality_job", job_id, operator,
407:               {"input_digest": job.input_digest, "provider": "hospital_llm"})
408:        db.commit()
409:    except HospitalLlmError as exc:
410:        job = db.get(AiQualityJob, job_id)
411:        if job:
412:            job.status = "unknown" if exc.error_class in {"timeout", "network", "server"} else "failed"
413:            job.error_class = exc.error_class
414:            job.error_summary = "Hospital LLM analysis failed"
415:            job.finished_at = datetime.now(timezone.utc)
416:            _audit(db, "failed", "ai_quality_job", job_id, operator, {"error_class": exc.error_class})
417:            db.commit()
418:    except Exception as exc:
419:        job = db.get(AiQualityJob, job_id)
420:        if job:
421:            leftover = "".join(pieces).strip() if pieces else ""
422:            recovered = False
423:            if leftover:
424:                try:
425:                    result = analysis_from_llm_text(
426:                        leftover, request_id=request_id, input_digest=payload["input_digest"]
427:                    )
428:                    if db.scalar(select(AiQualityResult).where(AiQualityResult.job_id == job_id)) is None:
429:                        db.add(AiQualityResult(
430:                            job_id=job_id, risk_level=result.risk_level, summary=result.summary,
431:                            structured_result=result.model_dump(), output_digest=output_digest(result),
432:                        ))
433:                    job.status = "succeeded"
434:                    job.error_class = None
435:                    job.error_summary = None
436:                    job.dify_run_id = settings.hospital_llm_model[:64]
437:                    job.duration_ms = int((time.monotonic() - started) * 1000)
438:                    job.finished_at = datetime.now(timezone.utc)
439:                    _audit(db, "succeeded", "ai_quality_job", job_id, operator,
440:                           {"input_digest": job.input_digest, "provider": "hospital_llm", "recovered": True})
441:                    recovered = True
442:                except Exception:
443:                    recovered = False
444:            if not recovered:
445:                job.status = "blocked"
446:                job.error_class = "contract"
447:                job.error_summary = "Hospital LLM output contract rejected"
448:                job.finished_at = datetime.now(timezone.utc)
449:                usage = dict(job.token_usage or {})
450:                usage["contract_reason"] = type(exc).__name__
451:                job.token_usage = usage
452:                _audit(db, "blocked", "ai_quality_job", job_id, operator, {"error_class": "contract"})
453:            db.commit()
454:    finally:
455:        db.close()
458:def _submit_hospital(req: AiQualityCreateRequest, db: Session, operator: str, *, retry_job=None):
459:    if retry_job is None:
460:        _require_preview_request_id(req.request_id)
461:    try:
462:        payload = _make(req, db, req.request_id)
463:    except ValueError as exc:
464:        raise HTTPException(422, str(exc)) from exc
465:    if retry_job is None and not hmac.compare_digest(payload["input_digest"], req.input_digest):
466:        raise HTTPException(422, "input_digest does not match server preview")
467:    job, built = _new_job(req, db, operator, payload, retry_job=retry_job, prompt_version="hospital-llm-analysis-v1")
468:    if built is None:
469:        return job
470:    if job.status == "running":
471:        threading.Thread(
472:            target=_finish_hospital_job,
473:            args=(job.id, built, operator, req.request_id),
474:            daemon=True,
475:        ).start()
476:        # Worker commits via its own SessionLocal; expire the request-session
477:        # copy so the response reflects the latest committed status.
478:        db.expire(job)
479:    return job
482:def _submit(req: AiQualityCreateRequest, db: Session, operator: str, *, retry_job=None):
483:    if _hospital_ready():
484:        return _submit_hospital(req, db, operator, retry_job=retry_job)
485:    if not settings.dify_quality_enabled:
486:        raise HTTPException(409, "AI quality analysis is disabled")
487:    if retry_job is None:
488:        _require_preview_request_id(req.request_id)
489:    client = DifyQualityClient()
490:    try:
491:        client._validate_base()
492:        client._api_key()
493:    except DifyClientError as exc:
494:        _audit(db, "submit_rejected", "dify_workflow", settings.dify_quality_workflow_name,
495:               operator, {"error_class": exc.error_class})
496:        db.commit()
497:        raise HTTPException(409, detail={"error_class": exc.error_class}) from exc
498:    try:
499:        payload = _make(req, db, req.request_id)
500:    except ValueError as exc: raise HTTPException(422, str(exc)) from exc
501:    if not hmac.compare_digest(payload["input_digest"], req.input_digest):
502:        raise HTTPException(422, "input_digest does not match server preview")
503:    key_material = f"quality|{req.task_type}|{sorted(req.finding_ids)}|{req.run_id}|{payload['input_digest']}|{settings.dify_quality_prompt_version}"
504:    job_key = hashlib.sha256(key_material.encode()).hexdigest()
505:    job = retry_job or db.scalar(select(AiQualityJob).where(AiQualityJob.job_key == job_key))
506:    if job and retry_job is None:
507:        _audit(db, "reuse", "ai_quality_job", job.id, operator, {"status": job.status})
508:        db.commit()
509:        return job
510:    job = job or AiQualityJob(job_key=job_key, task_type=req.task_type, prompt_version=settings.dify_quality_prompt_version,
511:        schema_version=INPUT_SCHEMA, input_digest=payload["input_digest"], request_id=req.request_id,
512:        input_summary={"finding_count": len(req.finding_ids), "finding_ids": sorted(req.finding_ids), "run_id": req.run_id, "payload_bytes": payload["payload_bytes"], "dropped_count": len(payload["dropped_fields"])}, requested_by=operator)
513:    job.status, job.attempt, job.started_at = "running", (job.attempt or 0) + 1, datetime.now(timezone.utc)
514:    db.add(job); db.flush()
515:    for fid in sorted(set(req.finding_ids)):
516:        if not db.scalar(select(AiQualityJobFinding).where(AiQualityJobFinding.job_id == job.id, AiQualityJobFinding.finding_id == fid)):
517:            db.add(AiQualityJobFinding(job_id=job.id, finding_id=fid))
518:    _audit(db, "submit", "ai_quality_job", job.id, operator, {"input_digest": job.input_digest}); db.commit()
519:    started = time.monotonic()
520:    try:
521:        user_key = settings.jwt_secret.encode()
522:        user = "aq-" + hmac.new(user_key, str(operator).encode(), hashlib.sha256).hexdigest()[:32]
523:        response = client.run_workflow(inputs={k: payload[k] for k in ("schema_version", "request_id", "task_type", "prompt_version", "payload_json", "input_digest")}, user=user)
524:        result = validate_output(response.payload, request_id=req.request_id, input_digest=payload["input_digest"])
525:        job.status, job.dify_run_id = "succeeded", str(response.payload.get("workflow_run_id") or response.payload.get("task_id") or "")[:64]
526:        data = response.payload.get("data") or {}; job.token_usage = data.get("usage") if isinstance(data, dict) else None
527:        db.add(AiQualityResult(job_id=job.id, risk_level=result.risk_level, summary=result.summary, structured_result=result.model_dump(), output_digest=output_digest(result)))
528:        _audit(db, "succeeded", "ai_quality_job", job.id, operator,
529:               {"input_digest": job.input_digest, "output_digest": output_digest(result)})
530:    except DifyClientError as exc:
531:        if exc.error_class in {"timeout", "network", "server"}:
532:            state, error_class = "unknown", exc.error_class
533:        elif exc.error_class in {"invalid_json", "response_too_large", "redirect_blocked", "ssrf_blocked"}:
534:            state, error_class = "blocked", "contract"
535:        else:
536:            state, error_class = "failed", exc.error_class
537:        job.status, job.error_class, job.error_summary = state, error_class, "Dify request failed"
538:        _audit(db, "failed", "ai_quality_job", job.id, operator, {"error_class": error_class, "status": state})
539:    except Exception:
540:        job.status, job.error_class, job.error_summary = "blocked", "contract", "Dify output contract rejected"
541:        _audit(db, "blocked", "ai_quality_job", job.id, operator, {"error_class": "contract"})
542:    job.duration_ms = int((time.monotonic() - started) * 1000); job.finished_at = datetime.now(timezone.utc); db.commit()
543:    return job
546:@router.post("/jobs", dependencies=[Depends(require_permission("asset.quality.ai.analyze"))])
547:def create_job(req: AiQualityCreateRequest, request: Request, db: Session = Depends(get_db)) -> ApiResponse[dict]:
548:    job = _submit(req, db, get_current_user(request))
549:    return ApiResponse(data=_job_payload(db, job))
552:@router.post("/jobs/{job_id}/retry", dependencies=[Depends(require_permission("asset.quality.ai.analyze"))])
553:def retry_job(job_id: int, request: Request, db: Session = Depends(get_db)) -> ApiResponse[dict]:
554:    job = db.get(AiQualityJob, job_id)
555:    if not job: raise HTTPException(404, "job not found")
556:    if job.status not in {"failed", "unknown"} or job.error_class in {"contract", "auth", "validation", "not_configured", "blocked"}:
557:        raise HTTPException(409, "job is not retryable")
558:    req = AiQualityCreateRequest(task_type=job.task_type, finding_ids=db.scalars(select(AiQualityJobFinding.finding_id).where(AiQualityJobFinding.job_id == job.id)).all(), run_id=(job.input_summary or {}).get("run_id"), request_id=job.request_id, input_digest=job.input_digest)
559:    operator = get_current_user(request)
560:    _audit(db, "retry", "ai_quality_job", job.id, operator, {"attempt": (job.attempt or 0) + 1})
561:    db.commit()
562:    job = _submit(req, db, operator, retry_job=job)
563:    return ApiResponse(data=_job_payload(db, job))
566:@router.patch("/results/{result_id}/review", dependencies=[Depends(require_permission("asset.quality.ai.review"))])
567:def review_result(result_id: int, req: AiQualityReviewRequest, request: Request, db: Session = Depends(get_db)) -> ApiResponse[dict]:
568:    result = db.get(AiQualityResult, result_id)
569:    if not result: raise HTTPException(404, "result not found")
570:    recommendations = (result.structured_result or {}).get("recommendations", [])
571:    accepted = req.accepted_recommendations or []
572:    if len(accepted) != len(set(accepted)) or any(i < 0 or i >= len(recommendations) for i in accepted):
573:        raise HTTPException(422, "accepted recommendation index not in result")
574:    if req.status == "rejected" and accepted:
575:        raise HTTPException(422, "rejected result cannot accept recommendations")
576:    if req.status == "accepted" and not accepted:
577:        accepted = list(range(len(recommendations)))
578:    if req.status == "partial" and (not accepted or len(accepted) >= len(recommendations)):
579:        raise HTTPException(422, "partial review requires a non-empty proper subset")
580:    result.review_status, result.review_by, result.review_at, result.review_note, result.accepted_recommendations = req.status, get_current_user(request), datetime.now(timezone.utc), req.note, accepted
581:    _audit(db, "review", "ai_quality_result", result.id, result.review_by, {"review_status": req.status}); db.commit()
582:    return ApiResponse(data=AiQualityResultItem.model_validate(result).model_dump())
585:@router.post("/results/{result_id}/attach", dependencies=[Depends(require_permission("asset.quality.ai.review"))])
586:def attach_result(result_id: int, req: AiQualityAttachRequest, request: Request, db: Session = Depends(get_db)) -> ApiResponse[dict]:
587:    result = db.get(AiQualityResult, result_id)
588:    if not result: raise HTTPException(404, "result not found")
589:    if result.review_status not in {"accepted", "partial"}: raise HTTPException(409, "review result before attach")
590:    recommendations = (result.structured_result or {}).get("recommendations", [])
591:    if len(req.recommendation_indexes) != len(set(req.recommendation_indexes)) or any(i < 0 or i >= len(recommendations) for i in req.recommendation_indexes): raise HTTPException(422, "recommendation index not in result")
592:    reviewed = result.accepted_recommendations
593:    if reviewed is not None and any(i not in reviewed for i in req.recommendation_indexes):
594:        raise HTTPException(422, "recommendation was not accepted in review")
595:    operator = get_current_user(request); result.attached_by, result.attached_at, result.accepted_recommendations = operator, datetime.now(timezone.utc), req.recommendation_indexes
596:    _audit(db, "attach", "ai_quality_result", result.id, operator,
597:           {"recommendation_count": len(req.recommendation_indexes), "has_note": bool(req.note)}); db.commit()
598:    return ApiResponse(data=AiQualityResultItem.model_validate(result).model_dump())
601:@router.post("/governance-report", dependencies=[Depends(require_permission("asset.quality.ai.analyze"))])
602:def create_governance_report(request: Request, db: Session = Depends(get_db)) -> ApiResponse[dict]:
603:    if not settings.hospital_llm_enabled:
604:        raise HTTPException(409, "Hospital LLM is disabled")
605:    operator = get_current_user(request)
606:    brief = build_governance_brief(db)
607:    digest = hashlib.sha256(brief.encode("utf-8")).hexdigest()
608:    job_key = hashlib.sha256(f"hospital-report|{digest}".encode()).hexdigest()
609:    existing = db.scalar(select(AiQualityJob).where(AiQualityJob.job_key == job_key, AiQualityJob.status == "succeeded"))
610:    if existing:
611:        return ApiResponse(data=_job_payload(db, existing))
612:    job = AiQualityJob(
613:        job_key=job_key,
614:        task_type="run_summary",
615:        prompt_version="hospital-llm-report-v1",
616:        schema_version="governance-report/v1",
617:        input_digest=digest,
618:        request_id=_new_request_id(),
619:        input_summary={"kind": "governance_report", "bytes": len(brief.encode("utf-8"))},
620:        requested_by=operator,
621:        status="running",
622:        attempt=1,
623:        started_at=datetime.now(timezone.utc),
624:    )
625:    db.add(job)
626:    db.commit()
627:    db.refresh(job)
628:    threading.Thread(
629:        target=_finish_hospital_job,
630:        args=(job.id, {"payload_json": brief, "input_digest": digest}, operator, job.request_id),
631:        daemon=True,
632:    ).start()
633:    # Same stale-ORM concern as _submit_hospital: worker owns its session.
634:    db.expire(job)
635:    return ApiResponse(data=_job_payload(db, job))

