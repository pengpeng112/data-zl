143:        <el-table-column prop="id" label="任务" width="70" />
144:        <el-table-column label="类型" width="120">
145:          <template #default="{ row }">{{ row.task_type === "run_summary" ? "总览报告" : "问题分析" }}</template>
146:        </el-table-column>
