68:case "${1:-}" in
69:  --domain-baseline)
70:    OUT="${2:-$ROOT/开发起步包/output_domain_baseline.txt}"
71:    { echo "# other-domain hash baseline $(date '+%F %T') HEAD=$(git -C "$ROOT" rev-parse --short HEAD)"
72:      cd "$ROOT" && git hash-object $(domain_files_existing)
73:    } > "$OUT"
74:    echo "[baseline] $(grep -c . "$OUT") 行 -> $OUT";;
75:  --domain-check)
76:    BASE="${2:-$ROOT/开发起步包/output_domain_baseline.txt}"
77:    [[ -f "$BASE" ]] || { echo "[check] 基线不存在: $BASE（先 --domain-baseline）"; exit 2; }
78:    NOW="$(cd "$ROOT" && git hash-object $(domain_files_existing))"
79:    if diff <(grep -v '^#' "$BASE") <(echo "$NOW") >/dev/null; then
80:      echo "[check] 他人域 $(domain_files_existing | wc -l) 文件与基线一致 ✔"
81:    else
82:      echo "[check] ✘ 他人域有变动："
83:      diff <(grep -v '^#' "$BASE") <(echo "$NOW") || true
84:      exit 1
85:    fi;;
86:  "")
87:    ensure_tunnel && derive_url
88:    echo "[remind] 隔离库脚本一律显式 \$APP_TEST_DB_URL；跑全量 pytest 前终止非本会话 pytest；"
89:    echo "[remind] pytest 后按惯例重灌: PYTHONPATH=backend backend/.venv/Scripts/python.exe 开发起步包/output_r170/import170.py";;
90:  *) echo "用法: source tools/dev_env.sh | bash tools/dev_env.sh --domain-baseline|--domain-check [FILE]"; exit 2;;
# 开发起步包目录索引

> 本文件是 `开发起步包/` 的唯一权威目录、状态表和更新记录。任何 AI 或人员处理文档前必须先读本文件；不要以归档文档、旧计划或聊天记录判断当前状态。

## 接手顺序

1. 根目录 `AGENTS.md`：安全红线、代码约束、文档维护规则。
2. 本文件：定位当前文档、资产包和归档历史。
3. `55_系统未完成事项统一执行计划.md`：唯一未完成事项执行入口。
4. 按任务读取下表指定的权威口径、证据或模块计划。

