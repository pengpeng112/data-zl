29:tunnel_up() {
30:  # 185 WARN 最小修复：本机 Git Bash 的 grep 为 ugrep，netstat 输出（CRLF+GBK 头）
31:  # 使 `grep -q "127.0.0.1:15432.*LISTENING"` 恒不命中 → 误判隧道不在、重复建转发失败。
32:  # 改用 bash 内建 /dev/tcp 探测（无外部命令依赖，实测 2026-09-06）。
33:  (exec 3<>/dev/tcp/127.0.0.1/15432) 2>/dev/null
34:}
35:
36:ensure_tunnel() {
37:  if tunnel_up; then
38:    echo "[tunnel] 15432 已在监听（复用，未动现有转发）"
39:  else
40:    echo "[tunnel] 15432 不通，建立新转发…"
41:    ssh -f -N -L 15432:127.0.0.1:5432 -o ServerAliveInterval=30 \
42:      -o ExitOnForwardFailure=yes "${SSH_OPTS[@]}" root@10.10.8.83 2>/dev/null
43:    sleep 1
44:    tunnel_up && echo "[tunnel] 建立 OK" || { echo "[tunnel] 建立失败：检查公钥 SSH root@10.10.8.83"; return 1; }
45:  fi
46:}
47:
48:derive_url() {  # 口令不回显；输出写入全局 APP_TEST_DB_URL
49:  local url
50:  url="$(ssh "${SSH_OPTS[@]}" root@10.10.8.83 \
51:    'grep ^APP_DB_URL /etc/data-asset/backend.env' 2>/dev/null \
52:    | sed -E 's/^APP_DB_URL=//; s#@[^/]+/#@127.0.0.1:15432/#; s#/data_asset(\?.*)?$#/data_asset_test\1#')"
53:  if [[ -z "$url" || "$url" != *data_asset_test* ]]; then
54:    echo "[url] 推导失败（服务器 env 读取异常）" >&2; return 1
55:  fi
56:  export APP_TEST_DB_URL="$url"
57:  export APP_DB_URL="$url"
58:  echo "[url] APP_TEST_DB_URL 已设置 -> $(echo "$url" | sed -E 's#//[^@]+@#//***@#')"
59:}
