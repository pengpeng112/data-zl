# ============================================
# 数据资产管理平台 — 后端环境变量
#
# 生产部署：由 root 创建 /etc/data-asset/backend.env，权限 0640、属组 dataasset，
# 只写入真实值。此文件不纳入 Git 或发布包。systemd unit (data-asset.service)
# 通过 EnvironmentFile 读取该路径。
# 本地开发：复制为 backend/.env（已在 .gitignore 排除）。
# ============================================

# PostgreSQL 连接串 (psycopg driver)
APP_DB_URL=postgresql+psycopg://asset_app:REPLACE_WITH_PASSWORD@127.0.0.1:5432/data_asset

# CORS 允许的来源 (JSON 数组)。
# production 启动校验（111 S4）要求：不得为通配 "*"，不得保留 localhost/127.0.0.1。
# 请替换为实际公网/内网入口域名或固定 IP。
APP_CORS_ORIGINS=["https://data.example.com"]

# 凭据加密密钥 (Feret 密钥, 需 32 字符随机串)
APP_CREDENTIAL_ENCRYPT_KEY=REPLACE_WITH_SECURE_KEY

# 快照保留天数
APP_SNAPSHOT_RETENTION_DAYS=90

# 事件日志保留天数
APP_EVENT_RETENTION_DAYS=365

# 定时调度器时区
APP_SCHEDULER_TIMEZONE=Asia/Shanghai

# 运行环境：production 才走 111 号 S4 失败关闭校验（JWT/写开关/CORS/凭据/build 身份）。
APP_ENV=production

# 发布身份（108/111 号）：构建脚本注入，不得为占位；缺失时 production 拒绝启动。
APP_BUILD_ID=<由构建脚本注入，如 b-2026-1234>
APP_GIT_SHA=<由构建脚本注入，如 8 位 commit sha>

# 生产必须 true：未绑定用户/角色的 Token 访问管理模块默认拒绝
APP_RBAC_REQUIRE_BOUND_TOKEN=true

# 运维写通道：生产默认关闭；未经 D1-D5 确认不得打开（S4 强制校验=false）
APP_OPS_WRITE_ENABLED=false
APP_OPS_WRITE_D1_D5_CONFIRMED=false

# 字典下发默认关闭（写入类）
APP_DICT_MEDICAL_PUSH_ENABLED=false

# 身份同步/夜间写任务默认关闭（写入类）
APP_IDENTITY_SYNC_ENABLED=false
APP_IDENTITY_NIGHTLY_ENABLED=false
APP_IDENTITY_JHEMR_PASSWORD_WRITE_ENABLED=false

# ---- 本地账号登录 / JWT（59 号计划）----
# 生产改 RS256 并配置密钥文件路径（HS256 需 32+ 随机 secret，非占位）
APP_JWT_ALGORITHM=RS256
# APP_JWT_SECRET=<仅 HS256 使用，production 需 >=32 字符非占位>
APP_JWT_PRIVATE_KEY_PATH=/etc/data-asset/jwt_private.pem
APP_JWT_PUBLIC_KEY_PATH=/etc/data-asset/jwt_public.pem
APP_AUTH_ACCESS_TOKEN_TTL_MINUTES=15
APP_AUTH_REFRESH_TOKEN_TTL_HOURS=8
APP_AUTH_MAX_FAILED_LOGIN=5
APP_AUTH_LOCKOUT_MINUTES=15
# 与前端一致：8-18 位，数字/字母/符号至少两类
APP_AUTH_PASSWORD_MIN_LENGTH=8
APP_AUTH_PASSWORD_MAX_LENGTH=18
# 全站 HTTPS 时 true；内网 HTTP 部署保留 false，但必须保证 HttpOnly + SameSite=Lax +
# Cookie 路径限制与 CSRF 校验（111 S4 保留既有 HTTP 部署，不强制 HTTPS）。
APP_AUTH_COOKIE_SECURE=false
