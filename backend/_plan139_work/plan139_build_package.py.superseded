"""Build the plan-139 four-source asset package from harvested snapshots.

Pure file-to-file transformation: no database, no network, deterministic.
Reads the four read-only harvester snapshots and emits the package described
in plan 139 §3 (catalog/objects/columns/constraints/indexes/routines, view
inventory/dependencies, relation candidates, governance, import plan).

Layering rules are enforced structurally (plan 139 §4.2):
- declared PK/FK   -> structural relations (``db_constraint`` evidence);
- view references  -> dependency/lineage rows only;
- view JOINs       -> review-draft candidates (never formal relations);
- complex logic    -> inactive recipe candidates;
- unresolved ends  -> rejected records with machine-readable reasons.

Full view definitions are never written to the package: only SHA-256,
parse status and sanitized join expressions (literals masked by the shared
intake parser).
"""
from __future__ import annotations

import argparse
import csv
import hashlib
import json
import re
import sys
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterable, Mapping, Sequence

