GENERATOR = "plan139_build_package.v1"
PARSER_VERSION = "intake_his_view_relations.plan139.v1"

SYSTEM_SCHEMA_DBO = "dbo"
SQLSERVER_SYSTEM_SCHEMAS = {"cdc", "sys", "information_schema", "guest"}
SQLSERVER_SYSTEM_OBJECT_RE = re.compile(r"(?i)^(fn_cdc_|systranschemas|MSreplication)")


def _sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


