+def batch_update_changes(req: ChangeBatchRequest, request: Request, db: Session = Depends(get_db)) -> ApiResponse[dict]:
+    operator = get_current_user(request)
+    status_map = {
+        "acknowledge": "acknowledged",
+        "ignore": "ignored",
+        "resolve": "resolved",
+        "reopen": "open",
+    }
