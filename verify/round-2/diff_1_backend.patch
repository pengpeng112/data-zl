+        return AssetColumn(
+            system_code="TEST_QC",
+            source_code="test_qc_source",
+            namespace_name=None,
+            schema_name="TEST_QC",
+            table_name=table,
+            column_id=ordinal,
+            column_name=name,
+            comment=comment,
