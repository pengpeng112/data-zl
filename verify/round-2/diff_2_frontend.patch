+  } catch (error: any) {
+    ElMessage.error(detailMessage(error, "处理失败"));
+  } finally {
+    setBusy(id, action, false);
+  }
+}
+
+async function execute(id: number) {
+  setBusy(id, "execute", true);
+  try {
+    await executePermissionRequest(id);
+    ElMessage.success("执行成功");
