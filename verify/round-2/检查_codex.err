+        <el-form-item label="申请类型" prop="request_kind">
+          <el-radio-group v-model="createForm.request_kind">
+            <el-radio value="role">角色</el-radio>
+            <el-radio value="data_scope">数据范围</el-radio>
+          </el-radio-group>
+        </el-form-item>
