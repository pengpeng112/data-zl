+        )
+        assert paged.status_code == 200
+        assert paged.json()["data"]["total"] == 2
+        assert len(paged.json()["data"]["items"]) == 1
+    finally:
+        db.execute(delete(IdentityPerson).where(IdentityPerson.person_code.in_(codes)))
+        db.commit()
+        db.close()
