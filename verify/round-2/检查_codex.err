     仍未解析出 system/source 时按 asset_tables 唯一物理匹配反查（多命中不猜，返回 None）。
+    传入 resolver 时用预载索引反查（C1 批量化，已回填行天然零查询）。
     """
     if side == "from":
         sys_c = r.from_system_code
@@ -167,15 +242,20 @@ def _resolve_relation_endpoint(
