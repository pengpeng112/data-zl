     )
     if db is None or not run_id:
         return overall
diff --git a/backend/app/services/identity_sync_status.py b/backend/app/services/identity_sync_status.py
index 4bbbc5f..286d0e8 100644
--- a/backend/app/services/identity_sync_status.py
+++ b/backend/app/services/identity_sync_status.py
@@ -48,22 +48,27 @@ def aggregate_overall_status(
