+        from_id, to_id = _preview_pair(db)
+        other = _create_column_snapshot(db, "pytest_other", "other", ["ID"])
+        db.commit()
+        other_id = other.id
+    finally:
+        db.close()
+
+    missing = client.post("/api/v1/metadata-changes/diff-preview", json={
